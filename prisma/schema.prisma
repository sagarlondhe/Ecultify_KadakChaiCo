datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Submissions table holding all campaign entries
model StoryEntry {
  id              String    @id @default(cuid())
  publicId        String    @unique // Cryptographically secure unguessable 32-char hex token
  name            String    // Submitter's full name
  city            String    // Submitter's city
  contact         String    @unique // Validated email or normalized 10-digit Indian mobile (strictly private)
  story           String    // Chai story content (max 300 characters)
  consent         Boolean   @default(true) // Consent confirmation flag

  // Current operational status: "approved" | "rejected" | "pending_review"
  status          String    @default("pending_review")

  // AI Moderation Audit Trail (Immutable once recorded by AI)
  aiDecision      String?   // "approved" | "rejected" | null if AI call failed
  aiCategory      String?   // "funny" | "nostalgic" | "wholesome" | "other" | null
  aiCaption       String?   // Generated caption (max 12 words) | null
  aiReason        String?   // Rejection explanation from AI | null
  aiRawResponse   String?   // Optional raw JSON string for internal debugging

  // Admin Override Tracking (Preserves original AI audit trail)
  adminOverride   Boolean   @default(false)
  adminNotes      String?
  adminUser       String?   // Username of moderator who enacted override
  overriddenAt    DateTime?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}
